# === One-off debug/audit scripts (numbered pattern) ===
# These rules apply to root, VISNDT/, and database/ directories
_[0-9]*.mjs
_[0-9]*.sql
_[0-9]*.ts
_[0-9]*.cjs
_[0-9]*.ps1
_[0-9]*.txt
_[0-9]*.json
