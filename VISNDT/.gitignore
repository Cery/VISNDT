.trae-*.mjs

# Browser automation / CDP profiling artifacts (large ORT models, screenshots, dumps)
/database/.edge-cdp-*/
/database/_cdp_*
/database/*_shots*/
/database/_*clickthrough*/
/database/_*e2e_audit*/
/database/_*header_verify*/
/database/*.dmp

# Database scratch / one-off audit scripts (durable evidence lives in docs/_review)
/database/_*.mjs
/database/_*.sql
/database/_*.txt
/database/_*.ps1

# Prisma error-output stray (Prisma diff error redirect)
/database/prisma/migrations/new_migration.sql

