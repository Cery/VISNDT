# ===========================================
# VISNDT Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# Never commit real credentials.

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# --- S3 Compatible Object Storage ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Backend ---
PORT=4000
NODE_ENV=production

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Docker Deployment Secrets (REQUIRED for production) ---
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=<generate-production-password>
# POSTGRES_USER is optional, defaults to 'visndt' if not set
# POSTGRES_USER=visndt

# --- Authentication (JWT) ---
# Generate with: openssl rand -hex 64
JWT_SECRET=<generate-production-jwt-secret>
JWT_EXPIRES_IN=86400