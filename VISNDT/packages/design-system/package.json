{
  "name": "@visndt/design-system",
  "version": "1.0.0",
  "private": true,
  "description": "VISNDT UI Primitive Layer v1.0 — cross-platform (Web/Admin) reusable components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react,react-dom,@visndt/design-tokens,@visndt/identity-contract",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react,react-dom,@visndt/design-tokens,@visndt/identity-contract"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@visndt/design-tokens": "workspace:*",
    "@visndt/identity-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}