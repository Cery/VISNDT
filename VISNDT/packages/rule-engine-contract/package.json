{
  "name": "@visndt/rule-engine-contract",
  "version": "0.1.0",
  "private": true,
  "description": "VISNDT L0 Deterministic Rule Engine Contract v0.1 — rule definition/evaluation, scheduler boundary, completeness check & notification intent (pure TS, no ORM/API/AI runtime)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @visndt/identity-contract",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external @visndt/identity-contract"
  },
  "dependencies": {
    "@visndt/identity-contract": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}