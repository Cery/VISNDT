// ===========================================
// VISNDT Prisma Schema v1.0
// Based on: VISNDT Blueprint v1.0
// Reference: 400_Database-第二版 / 405_prisma.schema-第二版全新.md
// ===========================================
// 
// Model naming: PascalCase (Prisma convention)
// Database mapping: snake_case (@map)
// 
// Migration Plan per MVP Engineering Implementation Plan:
//   Migration 001: Identity (User, Organization, OrganizationMember)
//   Migration 002: Organization + Product
//   Migration 003: Offer + Demand + RFQ
//   Migration 004: Notification + Audit
// ===========================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// Enums
// ===========================================

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DemandStatus {
  DRAFT
  PUBLISHED
  SUBMITTED
  PROCESSING
  CLOSED
  CANCELLED
}

enum RFQStatus {
  DRAFT
  OPEN
  RESPONDING
  CLOSED
  CANCELLED
}

enum RFQResponseStatus {
  SUBMITTED
  VIEWED
  ACCEPTED
  REJECTED
}

enum WorkflowEntityType {
  DEMAND
  RFQ
  RFQ_RESPONSE
  OFFER
  MATCH
  CONTENT
}

enum WorkflowAction {
  CREATED
  SUBMITTED
  OPENED
  RESPONDED
  ACCEPTED
  REJECTED
  CLOSED
  WITHDRAWN
  REVIEWED
}

enum NotificationType {
  SYSTEM
  DEMAND_UPDATE
  RFQ_UPDATE
  RESPONSE_UPDATE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum FileEntityType {
  PRODUCT
  ORGANIZATION
  DEMAND
  RFQ
  RFQ_RESPONSE
  CONTENT
  SUPPLIER_PRODUCT
}

enum FileType {
  IMAGE
  DOCUMENT
  CERTIFICATE
  SPEC_SHEET
  ILLUSTRATION
  OTHER
}

enum FileAssetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SupplierProductStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  PUBLISHED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
}

enum ParameterDataType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
}

enum DemandMatchStatus {
  PENDING
  MATCHED
  REVIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InquiryStatus {
  NEW
  PROCESSING
  REPLIED
  CLOSED
}

enum ContentType {
  ARTICLE
  KNOWLEDGE
  SOLUTION
  INSIGHT
}

enum ContentTagType {
  TOPIC
  INDUSTRY
  APPLICATION
  TECHNOLOGY
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentMediaType {
  IMAGE
  ATTACHMENT
}

enum ConversionEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CONTENT_VIEW
  SEARCH
  PRODUCT_FILTER
  CTA_CLICK
  INQUIRY_START
  INQUIRY_SUBMIT
  SEARCH_SUBMITTED
  RESULT_VIEWED
  ENTITY_CLICKED
  DETAIL_OPENED
}

// ===========================================
// Migration 001: Identity & Organization Domain
// ===========================================

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  passwordHash   String     @map("password_hash")
  name           String?
  status         UserStatus @default(ACTIVE)
  organizationId String?    @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization             Organization?        @relation(fields: [organizationId], references: [id])
  memberships              OrganizationMember[]
  demands                  Demand[]
  workflowEvents           WorkflowEvent[]
  notifications            Notification[]
  fileAssets               FileAsset[]
  auditLogs                AuditLog[]
  rfqs                     RFQ[]
  reviewedRFQResponses     RFQResponse[]        @relation("RFQResponseReviewer")
  createdInvitations       UserInvitation[]
  refreshTokens            RefreshToken[]
  inquiries                Inquiry[]
  offers                   Offer[]
  createdProducts          Product[]
  contents                 Content[]
  knowledgeEntries         KnowledgeEntry[]
  reviewedSupplierProducts SupplierProduct[]    @relation("SupplierProductReviewer")

  @@index([organizationId])
  @@index([status])
  @@map("user")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_token")
}

model Organization {
  id     String             @id @default(uuid()) @db.Uuid
  name   String
  type   String             @map("organization_type")
  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members          OrganizationMember[]
  users            User[]
  offers           Offer[]
  demands          Demand[]
  targetedRfqs     RFQ[]                @relation("RFQTargetOrganization")
  rfqResponses     RFQResponse[]
  invitations      UserInvitation[]
  inquiries        Inquiry[]
  fileAssets       FileAsset[]
  supplierProducts SupplierProduct[]

  @@index([status])
  @@map("organization")
}

model UserInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  token          String    @unique
  organizationId String    @map("organization_id") @db.Uuid
  role           String    @default("MEMBER")
  status         String    @default("PENDING")
  expiresAt      DateTime  @map("expires_at")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  usedAt         DateTime? @map("used_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([token])
  @@map("user_invitation")
}

model OrganizationMember {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  role           String @default("MEMBER")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

// ===========================================
// Migration 002: Product Domain
// ===========================================

model ProductCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique
  parentId String? @map("parent_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent            ProductCategory?                  @relation("CategoryTree", fields: [parentId], references: [id])
  children          ProductCategory[]                 @relation("CategoryTree")
  products          Product[]
  demands           Demand[]
  knowledgeMappings ProductCategoryKnowledgeMapping[]

  @@index([parentId])
  @@map("product_category")
}

model Product {
  id          String                       @id @default(uuid()) @db.Uuid
  categoryId  String                       @map("category_id") @db.Uuid
  name        String
  model       String?
  description String?
  status      String                       @default("DRAFT")
  createdById String?                      @map("created_by_id") @db.Uuid
  slug        String?                      @unique
  seoTitle    String?                      @map("seo_title")
  embedding   Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category              ProductCategory              @relation(fields: [categoryId], references: [id])
  createdBy             User?                        @relation(fields: [createdById], references: [id])
  parameterAssociations ProductParameterDefinition[]
  parameterValues       ProductParameterValue[]
  offers                Offer[]
  media                 ProductMedia[]
  demandMatches         DemandMatch[]
  inquiries             Inquiry[]
  supplierProducts      SupplierProduct[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([model])
  @@index([createdById])
  @@map("product")
}

model ProductMedia {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  fileAssetId  String?  @map("file_asset_id") @db.Uuid
  mediaType    FileType @map("media_type")
  title        String?
  description  String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id])

  @@index([productId])
  @@index([fileAssetId])
  @@map("product_media")
}

model ParameterGroup {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  code        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  definitions ParameterDefinition[]

  @@index([code])
  @@map("parameter_group")
}

model ParameterDefinition {
  id               String            @id @default(uuid()) @db.Uuid
  parameterGroupId String?           @map("parameter_group_id") @db.Uuid
  name             String
  code             String            @unique @map("parameter_code")
  dataType         ParameterDataType @default(STRING) @map("data_type")
  unit             String?           @map("value_unit")
  required         Boolean           @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group                 ParameterGroup?                 @relation(fields: [parameterGroupId], references: [id])
  productAssociations   ProductParameterDefinition[]
  options               ParameterOption[]
  productValues         ProductParameterValue[]
  demandParameters      DemandParameter[]
  supplierProductValues SupplierProductParameterValue[]

  @@index([parameterGroupId])
  @@index([code])
  @@map("parameter_definition")
}

model ParameterOption {
  id                    String @id @default(uuid()) @db.Uuid
  parameterDefinitionId String @map("parameter_definition_id") @db.Uuid
  value                 String
  label                 String
  sortOrder             Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id], onDelete: Cascade)

  @@index([parameterDefinitionId])
  @@map("parameter_option")
}

model ProductParameterValue {
  id                    String @id @default(uuid()) @db.Uuid
  productId             String @map("product_id") @db.Uuid
  parameterDefinitionId String @map("parameter_definition_id") @db.Uuid
  value                 String
  valueNumber           Float? @map("value_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@unique([productId, parameterDefinitionId])
  @@index([parameterDefinitionId])
  @@index([parameterDefinitionId, value])
  @@index([parameterDefinitionId, valueNumber])
  @@map("product_parameter_value")
}

model ProductParameterDefinition {
  id                    String @id @default(uuid()) @db.Uuid
  productId             String @map("product_id") @db.Uuid
  parameterDefinitionId String @map("parameter_definition_id") @db.Uuid
  displayOrder          Int    @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@unique([productId, parameterDefinitionId])
  @@index([parameterDefinitionId])
  @@map("product_parameter_definition")
}

// ===========================================
// Migration 003: Offer Domain
// ===========================================

model Offer {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  supplierProductId String?     @map("supplier_product_id") @db.Uuid
  createdBy         String?     @map("created_by") @db.Uuid
  title             String
  description       String?
  price             Decimal?    @map("price") @db.Decimal(12, 2)
  currency          String?     @default("CNY") @map("currency")
  status            OfferStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  supplierProduct SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: Restrict)
  createdByUser   User?            @relation(fields: [createdBy], references: [id])
  rfqResponses    RFQResponse[]
  demandMatches   DemandMatch[]

  @@unique([organizationId, productId])
  @@index([productId])
  @@index([status])
  @@index([supplierProductId])
  @@map("offer")
}

// ===========================================
// Hybrid Model C: Supplier Product Domain
// ===========================================

model SupplierProduct {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  platformProductId String @map("platform_product_id") @db.Uuid

  // Product Identity
  brand       String
  series      String?
  modelNumber String
  slug        String? @unique

  // Content
  description          String?
  technicalDescription String? @map("technical_description")
  applicationInfo      String? @map("application_info")

  // Governance
  status       SupplierProductStatus @default(DRAFT)
  submittedAt  DateTime?             @map("submitted_at")
  reviewedAt   DateTime?             @map("reviewed_at")
  reviewedBy   String?               @map("reviewed_by") @db.Uuid
  reviewedNote String?               @map("reviewed_note")
  publishedAt  DateTime?             @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id])
  platformProduct Product      @relation(fields: [platformProductId], references: [id], onDelete: Restrict)
  reviewedByUser  User?        @relation("SupplierProductReviewer", fields: [reviewedBy], references: [id])

  parameterValues SupplierProductParameterValue[]
  media           SupplierProductMedia[]
  offers          Offer[]

  @@unique([organizationId, platformProductId, modelNumber])
  @@index([organizationId])
  @@index([platformProductId])
  @@index([modelNumber])
  @@index([status])
  @@map("supplier_product")
}

model SupplierProductMedia {
  id                String   @id @default(uuid()) @db.Uuid
  supplierProductId String   @map("supplier_product_id") @db.Uuid
  fileAssetId       String?  @map("file_asset_id") @db.Uuid
  mediaType         FileType @map("media_type")
  documentType      String?  @map("document_type")
  title             String?
  altText           String?  @map("alt_text")
  isPrimary         Boolean  @default(false) @map("is_primary")
  displayOrder      Int      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset?      @relation(fields: [fileAssetId], references: [id])

  @@index([supplierProductId])
  @@index([fileAssetId])
  @@map("supplier_product_media")
}

model SupplierProductParameterValue {
  id                    String @id @default(uuid()) @db.Uuid
  supplierProductId     String @map("supplier_product_id") @db.Uuid
  parameterDefinitionId String @map("parameter_definition_id") @db.Uuid
  value                 String
  valueNumber           Float? @map("value_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierProduct     SupplierProduct     @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@unique([supplierProductId, parameterDefinitionId])
  @@index([parameterDefinitionId])
  @@map("supplier_product_parameter_value")
}

// ===========================================
// Migration 003: Demand & RFQ Domain
// ===========================================

model Demand {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  organizationId String?      @map("organization_id") @db.Uuid
  createdBy      String       @map("created_by") @db.Uuid
  status         DemandStatus @default(DRAFT)
  parametersJson Json?        @map("parameters_json")
  budgetRange    String?      @map("budget_range")

  quantity             Int?      @map("quantity")
  quantityUnit         String?   @map("quantity_unit")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  contactName          String?   @map("contact_name")
  contactPhone         String?   @map("contact_phone")
  contactEmail         String?   @map("contact_email")
  contactVisible       Boolean   @default(false) @map("contact_visible")
  publishedAt          DateTime? @map("published_at")
  closedAt             DateTime? @map("closed_at")
  closeReason          String?   @map("close_reason")
  categoryId           String?   @map("category_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdByUser User              @relation(fields: [createdBy], references: [id])
  organization  Organization?     @relation(fields: [organizationId], references: [id])
  category      ProductCategory?  @relation(fields: [categoryId], references: [id])
  rfqs          RFQ[]
  parameters    DemandParameter[]
  matches       DemandMatch[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@map("demand")
}

model DemandParameter {
  id                    String  @id @default(uuid()) @db.Uuid
  demandId              String  @map("demand_id") @db.Uuid
  parameterDefinitionId String  @map("parameter_definition_id") @db.Uuid
  value                 String?
  valueMin              Float?  @map("value_min")
  valueMax              Float?  @map("value_max")
  required              Boolean @default(true)
  priority              Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand              Demand              @relation(fields: [demandId], references: [id])
  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@unique([demandId, parameterDefinitionId])
  @@index([parameterDefinitionId])
  @@map("demand_parameter")
}

model DemandMatch {
  id           String            @id @default(uuid()) @db.Uuid
  demandId     String            @map("demand_id") @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  matchScore   Float             @map("match_score")
  matchStatus  DemandMatchStatus @default(PENDING) @map("match_status")
  matchDetails Json?             @map("match_details")
  offerId      String?           @map("offer_id") @db.Uuid
  matchedAt    DateTime?         @map("matched_at")
  reviewedAt   DateTime?         @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand  Demand  @relation(fields: [demandId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  offer   Offer?  @relation(fields: [offerId], references: [id])
  rfqs    RFQ[]   @relation("RFQSourceMatch")

  @@unique([demandId, productId])
  @@index([productId])
  @@index([matchStatus])
  @@index([matchScore])
  @@map("demand_match")
}

model RFQ {
  id                   String    @id @default(uuid()) @db.Uuid
  demandId             String    @map("demand_id") @db.Uuid
  sourceMatchId        String?   @map("source_match_id") @db.Uuid
  targetOrganizationId String?   @map("target_organization_id") @db.Uuid
  createdBy            String    @map("created_by") @db.Uuid
  status               RFQStatus @default(DRAFT)
  publishedAt          DateTime? @map("published_at")
  closedAt             DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand             Demand        @relation(fields: [demandId], references: [id])
  sourceMatch        DemandMatch?  @relation("RFQSourceMatch", fields: [sourceMatchId], references: [id])
  targetOrganization Organization? @relation("RFQTargetOrganization", fields: [targetOrganizationId], references: [id])
  createdByUser      User          @relation(fields: [createdBy], references: [id])
  responses          RFQResponse[]

  @@index([createdBy])
  @@index([demandId])
  @@index([status])
  @@index([targetOrganizationId, status])
  @@map("rfq")
}

model RFQResponse {
  id             String            @id @default(uuid()) @db.Uuid
  rfqId          String            @map("rfq_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  offerId        String?           @map("offer_id") @db.Uuid
  reviewedBy     String?           @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?         @map("reviewed_at")
  decisionNote   String?           @map("decision_note")
  message        String?
  status         RFQResponseStatus @default(SUBMITTED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rfq            RFQ          @relation(fields: [rfqId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  offer          Offer?       @relation(fields: [offerId], references: [id])
  reviewedByUser User?        @relation("RFQResponseReviewer", fields: [reviewedBy], references: [id])

  @@unique([rfqId, organizationId])
  @@index([organizationId])
  @@index([offerId])
  @@index([reviewedBy])
  @@index([rfqId, status])
  @@index([status])
  @@map("rfq_response")
}

// ===========================================
// Migration 004: Workflow & Notification Domain
// ===========================================

model WorkflowEvent {
  id         String             @id @default(uuid()) @db.Uuid
  entityType WorkflowEntityType @map("entity_type")
  entityId   String             @map("entity_id") @db.Uuid
  action     WorkflowAction
  operatorId String             @map("operator_id") @db.Uuid
  metadata   Json?              @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operator User @relation(fields: [operatorId], references: [id])

  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
  @@map("workflow_event")
}

model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  type          NotificationType
  status        NotificationStatus @default(UNREAD)
  title         String
  message       String
  referenceType String?            @map("reference_type")
  referenceId   String?            @map("reference_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([type])
  @@index([createdAt])
  @@map("notification")
}

// ===========================================
// Migration 004: File Asset & Audit Domain
// ===========================================

model FileAsset {
  id             String          @id @default(uuid()) @db.Uuid
  entityType     FileEntityType  @map("entity_type")
  entityId       String          @map("entity_id") @db.Uuid
  fileType       FileType        @map("file_type")
  fileName       String          @map("file_name")
  storageKey     String          @map("storage_key")
  mimeType       String          @map("mime_type")
  fileSize       Int             @map("file_size")
  uploadedBy     String          @map("uploaded_by") @db.Uuid
  organizationId String?         @map("organization_id") @db.Uuid
  status         FileAssetStatus @default(ACTIVE) @map("status")
  deletedAt      DateTime?       @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  uploader             User                   @relation(fields: [uploadedBy], references: [id])
  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  media                ProductMedia[]
  contentCoverImages   Content[]
  contentMedia         ContentMedia[]
  supplierProductMedia SupplierProductMedia[]

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@map("file_asset")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  action     AuditAction
  operatorId String      @map("operator_id") @db.Uuid
  oldValue   Json?       @map("old_value") @db.JsonB
  newValue   Json?       @map("new_value") @db.JsonB
  ipAddress  String?     @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  operator User @relation(fields: [operatorId], references: [id])

  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ===========================================
// Migration 005: Inquiry Domain
// ===========================================

model Inquiry {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String?       @map("product_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  createdById    String?       @map("created_by_id") @db.Uuid
  contactName    String?       @map("contact_name")
  contactEmail   String?       @map("contact_email")
  contactPhone   String?       @map("contact_phone")
  message        String
  status         InquiryStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product      Product?      @relation(fields: [productId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("inquiry")
}

// ===========================================
// Migration 006: Content Domain
// ===========================================

model Content {
  id                 String                       @id @default(uuid()) @db.Uuid
  type               ContentType
  title              String
  slug               String                       @unique
  summary            String?
  content            String
  coverImageId       String?                      @map("cover_image_id") @db.Uuid
  status             ContentStatus                @default(DRAFT)
  authorId           String                       @map("author_id") @db.Uuid
  publishedAt        DateTime?                    @map("published_at")
  archivedAt         DateTime?                    @map("archived_at")
  scheduledPublishAt DateTime?                    @map("scheduled_publish_at")
  seoTitle           String?                      @map("seo_title")
  seoDescription     String?                      @map("seo_description")
  seoKeywords        String?                      @map("seo_keywords")
  estimatedReadTime  Int?                         @map("estimated_read_time")
  embedding          Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author        User                  @relation(fields: [authorId], references: [id])
  coverImage    FileAsset?            @relation(fields: [coverImageId], references: [id])
  media         ContentMedia[]
  revisions     ContentRevision[]
  tags          ContentTagRelation[]
  chunks        ContentChunk[]
  knowledgeRefs KnowledgeContentRef[]

  @@index([type, status])
  @@index([authorId])
  @@index([status])
  @@index([status, scheduledPublishAt])
  @@index([status, publishedAt])
  @@map("content")
}

// ===========================================
// Migration 006: Content Media Domain
// ===========================================

model ContentMedia {
  id          String           @id @default(uuid()) @db.Uuid
  contentId   String           @map("content_id") @db.Uuid
  fileAssetId String?          @map("file_asset_id") @db.Uuid
  type        ContentMediaType @default(IMAGE)
  caption     String?
  altText     String?          @map("alt_text")
  sortOrder   Int              @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  content   Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id])

  @@index([contentId])
  @@index([fileAssetId])
  @@map("content_media")
}

// ===========================================
// Migration 007: Content Revision Domain
// ===========================================

model ContentRevision {
  id             String   @id @default(uuid()) @db.Uuid
  contentId      String   @map("content_id") @db.Uuid
  version        Int
  title          String
  summary        String?
  content        String
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String?  @map("seo_keywords")
  coverImageId   String?  @map("cover_image_id") @db.Uuid
  snapshot       Json?
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  contentRef Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, version])
  @@map("content_revision")
}

// ===========================================
// Migration 008: Content Tagging & Taxonomy
// ===========================================

model ContentTag {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  type        ContentTagType
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  relations ContentTagRelation[]

  @@map("content_tag")
}

model ContentTagRelation {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  content Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentId, tagId])
  @@index([tagId])
  @@index([contentId])
  @@map("content_tag_relation")
}

// ===========================================
// Migration 009: Analytics Event Domain
// ===========================================

model ConversionEvent {
  id             String              @id @default(uuid()) @db.Uuid
  event          ConversionEventType
  userId         String?             @map("user_id") @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  sessionId      String?             @map("session_id")
  entityType     String?             @map("entity_type")
  entityId       String?             @map("entity_id") @db.Uuid
  source         String?
  metadata       Json?               @db.JsonB
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([event])
  @@index([userId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([event, createdAt])
  @@map("conversion_event")
}

// ===========================================
// Migration 010: AI Data Preparation
// ===========================================

model ContentChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  contentId  String                       @map("content_id") @db.Uuid
  chunkIndex Int                          @map("chunk_index")
  text       String
  embedding  Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  content Content @relation(fields: [contentId], references: [id])

  @@index([contentId])
  @@map("content_chunk")
}

// ===========================================
// Migration 013: Knowledge Base Classification
// ===========================================

model KnowledgeDomain {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  parentId    String? @map("parent_id") @db.Uuid
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent     KnowledgeDomain?    @relation("DomainHierarchy", fields: [parentId], references: [id])
  children   KnowledgeDomain[]   @relation("DomainHierarchy")
  categories KnowledgeCategory[]
  entries    KnowledgeEntry[]

  @@map("knowledge_domain")
}

model KnowledgeCategory {
  id          String  @id @default(uuid()) @db.Uuid
  domainId    String  @map("domain_id") @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  domain                  KnowledgeDomain                   @relation(fields: [domainId], references: [id])
  entries                 KnowledgeEntry[]
  productCategoryMappings ProductCategoryKnowledgeMapping[]

  @@unique([domainId, slug])
  @@index([domainId])
  @@map("knowledge_category")
}

// ===========================================
// Migration 014: Knowledge Association Layer
// ===========================================

enum KnowledgeEntryStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeReferenceType {
  SOURCE
  RELATED
  SUPPLEMENT
}

enum KnowledgeRelationType {
  RELATED
  CHILD
  PARENT
  PREREQUISITE
  FOLLOWUP
}

model KnowledgeEntry {
  id             String               @id @default(uuid()) @db.Uuid
  domainId       String               @map("domain_id") @db.Uuid
  categoryId     String               @map("category_id") @db.Uuid
  title          String
  slug           String               @unique
  summary        String?
  structuredBody Json                 @map("structured_body")
  status         KnowledgeEntryStatus @default(DRAFT)
  authorId       String               @map("author_id") @db.Uuid
  publishedAt    DateTime?            @map("published_at")
  seoTitle       String?              @map("seo_title")
  seoDescription String?              @map("seo_description")
  seoKeywords    String?              @map("seo_keywords")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  domain          KnowledgeDomain       @relation(fields: [domainId], references: [id])
  category        KnowledgeCategory     @relation(fields: [categoryId], references: [id])
  author          User                  @relation(fields: [authorId], references: [id])
  contentRefs     KnowledgeContentRef[]
  sourceRelations KnowledgeRelation[]   @relation("KnowledgeRelationSource")
  targetRelations KnowledgeRelation[]   @relation("KnowledgeRelationTarget")

  @@index([domainId])
  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@map("knowledge_entry")
}

model KnowledgeContentRef {
  id            String                 @id @default(uuid()) @db.Uuid
  knowledgeId   String                 @map("knowledge_id") @db.Uuid
  contentId     String                 @map("content_id") @db.Uuid
  referenceType KnowledgeReferenceType @default(SOURCE) @map("reference_type")
  sortOrder     Int                    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  knowledge KnowledgeEntry @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  content   Content        @relation(fields: [contentId], references: [id])

  @@unique([knowledgeId, contentId])
  @@index([knowledgeId])
  @@index([contentId])
  @@map("knowledge_content_ref")
}

model KnowledgeRelation {
  id           String                @id @default(uuid()) @db.Uuid
  sourceId     String                @map("source_id") @db.Uuid
  targetId     String                @map("target_id") @db.Uuid
  relationType KnowledgeRelationType @map("relation_type")
  description  String?

  createdAt DateTime @default(now()) @map("created_at")

  source KnowledgeEntry @relation("KnowledgeRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target KnowledgeEntry @relation("KnowledgeRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId])
  @@index([targetId])
  @@map("knowledge_relation")
}

// ===========================================
// Migration 016: ProductCategoryKnowledgeMapping
// M24.1.1 — Product ↔ Knowledge Category Association
// ===========================================

model ProductCategoryKnowledgeMapping {
  id                  String  @id @default(uuid()) @db.Uuid
  productCategoryId   String  @map("product_category_id") @db.Uuid
  knowledgeCategoryId String  @map("knowledge_category_id") @db.Uuid
  sortOrder           Int     @default(0) @map("sort_order")
  isActive            Boolean @default(true) @map("is_active")

  productCategory   ProductCategory   @relation(fields: [productCategoryId], references: [id])
  knowledgeCategory KnowledgeCategory @relation(fields: [knowledgeCategoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productCategoryId, knowledgeCategoryId])
  @@index([productCategoryId])
  @@index([knowledgeCategoryId])
  @@map("product_category_knowledge_mapping")
}
