// ===========================================
// VISNDT Prisma Schema v1.0
// Based on: VISNDT Blueprint v1.0
// Reference: 400_Database-第二版 / 405_prisma.schema-第二版全新.md
// ===========================================
// 
// Model naming: PascalCase (Prisma convention)
// Database mapping: snake_case (@map)
// 
// Migration Plan per MVP Engineering Implementation Plan:
//   Migration 001: Identity (User, Organization, OrganizationMember)
//   Migration 002: Organization + Product
//   Migration 003: Offer + Demand + RFQ
//   Migration 004: Notification + Audit
// ===========================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// Enums
// ===========================================

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DemandStatus {
  DRAFT
  PUBLISHED
  SUBMITTED
  PROCESSING
  CLOSED
  CANCELLED
}

enum RFQStatus {
  DRAFT
  OPEN
  RESPONDING
  CLOSED
  CANCELLED
}

enum RFQResponseStatus {
  SUBMITTED
  VIEWED
  ACCEPTED
  REJECTED
}

enum WorkflowEntityType {
  DEMAND
  RFQ
  RFQ_RESPONSE
  OFFER
  MATCH
}

enum WorkflowAction {
  CREATED
  SUBMITTED
  OPENED
  RESPONDED
  ACCEPTED
  REJECTED
  CLOSED
  WITHDRAWN
  REVIEWED
}

enum NotificationType {
  SYSTEM
  DEMAND_UPDATE
  RFQ_UPDATE
  RESPONSE_UPDATE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum FileEntityType {
  PRODUCT
  ORGANIZATION
  DEMAND
  RFQ
  RFQ_RESPONSE
}

enum FileType {
  IMAGE
  DOCUMENT
  CERTIFICATE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
}

enum ParameterDataType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
}

enum DemandMatchStatus {
  PENDING
  MATCHED
  REVIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InquiryStatus {
  NEW
  PROCESSING
  REPLIED
  CLOSED
}

// ===========================================
// Migration 001: Identity & Organization Domain
// ===========================================

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  passwordHash   String     @map("password_hash")
  name           String?
  status         UserStatus @default(ACTIVE)
  organizationId String?    @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization?        @relation(fields: [organizationId], references: [id])
  memberships    OrganizationMember[]
  demands        Demand[]
  workflowEvents WorkflowEvent[]
  notifications  Notification[]
  fileAssets          FileAsset[]
  auditLogs           AuditLog[]
  rfqs                RFQ[]
  createdInvitations  UserInvitation[]
  refreshTokens       RefreshToken[]
  inquiries           Inquiry[]

  @@index([organizationId])
  @@index([status])
  @@map("user")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_token")
}

model Organization {
  id     String             @id @default(uuid()) @db.Uuid
  name   String
  type   String             @map("organization_type")
  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members      OrganizationMember[]
  users        User[]
  offers       Offer[]
  demands      Demand[]
  rfqResponses RFQResponse[]
  invitations  UserInvitation[]
  inquiries    Inquiry[]

  @@index([status])
  @@map("organization")
}

model UserInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  token          String    @unique
  organizationId String    @map("organization_id") @db.Uuid
  role           String    @default("MEMBER")
  status         String    @default("PENDING")
  expiresAt      DateTime  @map("expires_at")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  usedAt         DateTime? @map("used_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([token])
  @@map("user_invitation")
}

model OrganizationMember {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  role           String @default("MEMBER")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

// ===========================================
// Migration 002: Product Domain
// ===========================================

model ProductCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique
  parentId String? @map("parent_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  demands  Demand[]

  @@index([parentId])
  @@map("product_category")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  name        String
  model       String?
  description String?
  status      String  @default("DRAFT")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category              ProductCategory              @relation(fields: [categoryId], references: [id])
  parameterAssociations ProductParameterDefinition[]
  parameterValues       ProductParameterValue[]
  offers                Offer[]
  media                 ProductMedia[]
  demandMatches         DemandMatch[]
  inquiries             Inquiry[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([model])
  @@map("product")
}

model ProductMedia {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  fileAssetId  String?  @map("file_asset_id") @db.Uuid
  mediaType    FileType @map("media_type")
  title        String?
  description  String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product    @relation(fields: [productId], references: [id])
  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id])

  @@index([productId])
  @@index([fileAssetId])
  @@map("product_media")
}

model ParameterGroup {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  code        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  definitions ParameterDefinition[]

  @@index([code])
  @@map("parameter_group")
}

model ParameterDefinition {
  id               String  @id @default(uuid()) @db.Uuid
  parameterGroupId String? @map("parameter_group_id") @db.Uuid
  name             String
  code             String  @unique @map("parameter_code")
  dataType         ParameterDataType @default(STRING) @map("data_type")
  unit             String? @map("value_unit")
  required         Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group               ParameterGroup?              @relation(fields: [parameterGroupId], references: [id])
  productAssociations ProductParameterDefinition[]
  options             ParameterOption[]
  productValues       ProductParameterValue[]
  demandParameters    DemandParameter[]

  @@index([parameterGroupId])
  @@index([code])
  @@map("parameter_definition")
}

model ParameterOption {
  id                    String @id @default(uuid()) @db.Uuid
  parameterDefinitionId String @map("parameter_definition_id") @db.Uuid
  value                 String
  label                 String
  sortOrder             Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@index([parameterDefinitionId])
  @@map("parameter_option")
}

model ProductParameterValue {
  id                    String @id @default(uuid()) @db.Uuid
  productId             String @map("product_id") @db.Uuid
  parameterDefinitionId String @map("parameter_definition_id") @db.Uuid
  value                 String
  valueNumber           Float? @map("value_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product             Product             @relation(fields: [productId], references: [id])
  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@unique([productId, parameterDefinitionId])
  @@index([parameterDefinitionId])
  @@index([parameterDefinitionId, value])
  @@index([parameterDefinitionId, valueNumber])
  @@map("product_parameter_value")
}

model ProductParameterDefinition {
  id                    String @id @default(uuid()) @db.Uuid
  productId             String @map("product_id") @db.Uuid
  parameterDefinitionId String @map("parameter_definition_id") @db.Uuid
  displayOrder          Int    @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  product             Product             @relation(fields: [productId], references: [id])
  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@unique([productId, parameterDefinitionId])
  @@index([parameterDefinitionId])
  @@map("product_parameter_definition")
}

// ===========================================
// Migration 003: Offer Domain
// ===========================================

model Offer {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  title          String
  description    String?
  status         OfferStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  rfqResponses RFQResponse[]
  demandMatches DemandMatch[]

  @@unique([organizationId, productId])
  @@index([productId])
  @@index([status])
  @@map("offer")
}

// ===========================================
// Migration 003: Demand & RFQ Domain
// ===========================================

model Demand {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  organizationId String?      @map("organization_id") @db.Uuid
  createdBy      String       @map("created_by") @db.Uuid
  status         DemandStatus @default(DRAFT)
  parametersJson Json?        @map("parameters_json")
  budgetRange    String?      @map("budget_range")

  quantity             Int?       @map("quantity")
  quantityUnit         String?    @map("quantity_unit")
  expectedDeliveryDate DateTime?  @map("expected_delivery_date")
  contactName          String?    @map("contact_name")
  contactPhone         String?    @map("contact_phone")
  contactEmail         String?    @map("contact_email")
  contactVisible       Boolean    @default(false) @map("contact_visible")
  publishedAt          DateTime?  @map("published_at")
  closedAt             DateTime?  @map("closed_at")
  closeReason          String?    @map("close_reason")
  categoryId           String?    @map("category_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdByUser User              @relation(fields: [createdBy], references: [id])
  organization  Organization?     @relation(fields: [organizationId], references: [id])
  category      ProductCategory?  @relation(fields: [categoryId], references: [id])
  rfq           RFQ?
  parameters    DemandParameter[]
  matches       DemandMatch[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@map("demand")
}

model DemandParameter {
  id                    String  @id @default(uuid()) @db.Uuid
  demandId              String  @map("demand_id") @db.Uuid
  parameterDefinitionId String  @map("parameter_definition_id") @db.Uuid
  value                 String?
  valueMin              Float?  @map("value_min")
  valueMax              Float?  @map("value_max")
  required              Boolean @default(true)
  priority              Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand              Demand              @relation(fields: [demandId], references: [id])
  parameterDefinition ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id])

  @@unique([demandId, parameterDefinitionId])
  @@index([parameterDefinitionId])
  @@map("demand_parameter")
}

model DemandMatch {
  id          String             @id @default(uuid()) @db.Uuid
  demandId    String             @map("demand_id") @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  matchScore  Float              @map("match_score")
  matchStatus DemandMatchStatus  @default(PENDING) @map("match_status")
  matchDetails Json?              @map("match_details")
  offerId     String?            @map("offer_id") @db.Uuid
  matchedAt   DateTime?          @map("matched_at")
  reviewedAt  DateTime?          @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand  Demand  @relation(fields: [demandId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  offer   Offer?  @relation(fields: [offerId], references: [id])

  @@unique([demandId, productId])
  @@index([productId])
  @@index([matchStatus])
  @@index([matchScore])
  @@map("demand_match")
}

model RFQ {
  id          String    @id @default(uuid()) @db.Uuid
  demandId    String    @unique @map("demand_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  status      RFQStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at")
  closedAt    DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand        Demand        @relation(fields: [demandId], references: [id])
  createdByUser User          @relation(fields: [createdBy], references: [id])
  responses     RFQResponse[]

  @@index([createdBy])
  @@index([status])
  @@map("rfq")
}

model RFQResponse {
  id             String            @id @default(uuid()) @db.Uuid
  rfqId          String            @map("rfq_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  offerId        String?           @map("offer_id") @db.Uuid
  message        String?
  status         RFQResponseStatus @default(SUBMITTED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rfq          RFQ          @relation(fields: [rfqId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  offer        Offer?       @relation(fields: [offerId], references: [id])

  @@unique([rfqId, organizationId])
  @@index([organizationId])
  @@index([offerId])
  @@index([status])
  @@map("rfq_response")
}

// ===========================================
// Migration 004: Workflow & Notification Domain
// ===========================================

model WorkflowEvent {
  id         String             @id @default(uuid()) @db.Uuid
  entityType WorkflowEntityType @map("entity_type")
  entityId   String             @map("entity_id") @db.Uuid
  action     WorkflowAction
  operatorId String             @map("operator_id") @db.Uuid
  metadata   Json?              @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operator User @relation(fields: [operatorId], references: [id])

  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
  @@map("workflow_event")
}

model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  type          NotificationType
  status        NotificationStatus @default(UNREAD)
  title         String
  message       String
  referenceType String?            @map("reference_type")
  referenceId   String?            @map("reference_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([type])
  @@index([createdAt])
  @@map("notification")
}

// ===========================================
// Migration 004: File Asset & Audit Domain
// ===========================================

model FileAsset {
  id         String         @id @default(uuid()) @db.Uuid
  entityType FileEntityType @map("entity_type")
  entityId   String         @map("entity_id") @db.Uuid
  fileType   FileType       @map("file_type")
  fileName   String         @map("file_name")
  storageKey String         @map("storage_key")
  mimeType   String         @map("mime_type")
  fileSize   Int            @map("file_size")
  uploadedBy String         @map("uploaded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  uploader User @relation(fields: [uploadedBy], references: [id])
  media    ProductMedia[]

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@map("file_asset")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  action     AuditAction
  operatorId String      @map("operator_id") @db.Uuid
  oldValue   Json?       @map("old_value") @db.JsonB
  newValue   Json?       @map("new_value") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  operator User @relation(fields: [operatorId], references: [id])

  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ===========================================
// Migration 005: Inquiry Domain
// ===========================================

model Inquiry {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String?       @map("product_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  createdById    String?       @map("created_by_id") @db.Uuid
  contactName    String?       @map("contact_name")
  contactEmail   String?       @map("contact_email")
  contactPhone   String?       @map("contact_phone")
  message        String
  status         InquiryStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product      Product?      @relation(fields: [productId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("inquiry")
}
